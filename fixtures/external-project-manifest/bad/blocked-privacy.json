{
  "schema_version": 1,
  "manifest_version": "2026-06-04",
  "project": {
    "project_id": "blocked-target",
    "owner_repo": "example/blocked-target"
  },
  "suite_roots": [
    "evals"
  ],
  "authority": {
    "supported_modes": [
      "artifact_only"
    ],
    "default_mode": "artifact_only"
  },
  "runtime_evidence_policy": {
    "required": false,
    "missing_status": "not_configured"
  },
  "privacy": {
    "privacy_class": "restricted",
    "approval_status": "blocked",
    "scope": "restricted fixtures",
    "data_classes": [
      "restricted"
    ],
    "retention_policy_ref": "privacy/policies/restricted-retention.md",
    "redaction_policy_ref": "privacy/policies/restricted-redaction.md"
  },
  "artifact_policy": {
    "artifact_roots": [
      ".harness/evals/runs"
    ],
    "allow_absolute_paths": false,
    "allow_parent_traversal": false
  },
  "baseline_authority": {
    "owner": "target_project",
    "promotion_status": "not_configured"
  },
  "execution_policy": {
    "allow_target_execution": false,
    "black_box_execution_status": "blocked"
  },
  "unknown_field_policy": "reject"
}
