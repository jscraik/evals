{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/artifact-manifest.schema.json",
  "title": "Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "created_at", "retention", "privacy", "artifacts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy"],
      "properties": {
        "status": { "type": "string", "enum": ["retained_local", "gap"] },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "redaction_status", "contains_private_content", "contains_credentials"],
      "properties": {
        "class": { "type": "string" },
        "redaction_status": { "type": "string" },
        "contains_private_content": { "type": "boolean" },
        "contains_credentials": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256", "required"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
