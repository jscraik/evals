{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evals.local/schemas/assertion-result.schema.json",
  "title": "Assertion result",
  "description": "Deterministic assertion diagnostic emitted by evals-owned scorers and contract checks.",
  "type": "object",
  "required": [
    "assertion_id",
    "given",
    "should",
    "actual",
    "expected",
    "status",
    "evidence_refs",
    "reproduce_command",
    "diagnostic"
  ],
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "given": {
      "type": "string",
      "minLength": 1
    },
    "should": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reproduce_command": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic": {
      "type": "string"
    }
  }
}
