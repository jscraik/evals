{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/eval-case.schema.json",
  "title": "Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "suite_id", "owner", "fixture_source", "privacy", "promotion", "input", "expected", "scorers"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string", "enum": ["synthetic", "repo"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "fixture_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provenance", "redaction_status"],
      "properties": {
        "type": { "type": "string", "enum": ["synthetic", "real"] },
        "provenance": { "type": "string", "minLength": 1 },
        "redaction_status": { "type": "string", "enum": ["synthetic_no_redaction_needed", "redacted", "not_redacted"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "contains_private_content", "contains_credentials"],
      "properties": {
        "class": { "type": "string", "enum": ["synthetic_public", "internal", "private"] },
        "contains_private_content": { "type": "boolean" },
        "contains_credentials": { "type": "boolean" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baseline_owner"],
      "properties": {
        "status": { "type": "string", "enum": ["not_promoted", "candidate", "promoted"] },
        "baseline_owner": { "type": ["string", "null"] }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "payload"],
      "properties": {
        "command": { "type": "string", "enum": ["simulate-pr-closeout"] },
        "payload": { "type": "object" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "required_output_contains", "required_artifacts"],
      "properties": {
        "exit_code": { "type": "integer" },
        "required_output_contains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "required_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_presence", "artifact_path"],
      "properties": {
        "expected_presence": { "type": "string", "enum": ["missing", "present"] },
        "artifact_path": { "type": ["string", "null"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_bucket"],
      "properties": {
        "scenario_bucket": {
          "type": "string",
          "enum": ["nominal", "boundary", "adversarial", "out_of_scope", "comparative"]
        },
        "claim_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$" },
          "uniqueItems": true
        }
      }
    },
    "scenario_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_actor",
        "goal",
        "stakeholder_interests",
        "preconditions",
        "success_end_condition",
        "failure_modes",
        "acceptance_paths"
      ],
      "properties": {
        "primary_actor": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "stakeholder_interests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "success_end_condition": { "type": "string", "minLength": 1 },
        "failure_modes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "acceptance_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["given", "should", "evidence_refs", "scorers"],
            "properties": {
              "given": { "type": "string", "minLength": 1 },
              "should": { "type": "string", "minLength": 1 },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              },
              "scorers": {
                "type": "array",
                "items": { "type": "string", "enum": ["exit-code", "artifact-completeness", "required-output", "baseline-presence"] },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "scorers": {
      "type": "array",
      "items": { "type": "string", "enum": ["exit-code", "artifact-completeness", "required-output", "baseline-presence"] },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
