{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/eval-result.schema.json",
  "title": "Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "suite_id", "execution_mode", "status", "deterministic_verdict", "scorer_results_path", "baseline_result_path", "trace_events_path", "artifact_refs", "errors"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "type": "string", "enum": ["synthetic", "real"] },
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "deterministic_verdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "scorer_results_path": { "type": "string", "minLength": 1 },
    "baseline_result_path": { "type": "string", "minLength": 1 },
    "trace_events_path": { "type": "string", "minLength": 1 },
    "failed_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "given", "should", "actual", "expected", "status", "evidence_refs", "reproduce_command", "diagnostic"],
        "properties": {
          "assertion_id": { "type": "string", "minLength": 1 },
          "given": { "type": "string", "minLength": 1 },
          "should": { "type": "string", "minLength": 1 },
          "actual": { "type": "string" },
          "expected": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "reproduce_command": { "type": "string", "minLength": 1 },
          "diagnostic": { "type": "string" }
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
