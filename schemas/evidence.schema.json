{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "evidence_type", "status", "observed_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "evidence_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$" },
    "evidence_type": {
      "type": "string",
      "enum": [
        "artifact",
        "command",
        "validation_artifact",
        "scorer_result",
        "baseline_result",
        "trace_event",
        "linear_issue_ref",
        "runtime_state",
        "manifest"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "present", "missing", "verified", "blocked", "not_applicable"]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "path": { "type": ["string", "null"], "minLength": 1 },
    "command": { "type": ["string", "null"], "minLength": 1 },
    "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "manifest_path": { "type": ["string", "null"], "minLength": 1 },
    "detail": { "type": ["string", "null"], "minLength": 1 }
  }
}
