{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/latest-run.schema.json",
  "title": "Latest Run Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "case_id",
    "suite_id",
    "execution_mode",
    "generated_at",
    "artifact_root",
    "manifest_path",
    "result_path",
    "report_path",
    "command_log_path",
    "baseline_result_path",
    "scorer_results_path",
    "trace_events_path"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "type": "string", "enum": ["synthetic", "real"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "artifact_root": { "type": "string", "minLength": 1 },
    "manifest_path": { "type": "string", "minLength": 1 },
    "result_path": { "type": "string", "minLength": 1 },
    "report_path": { "type": "string", "minLength": 1 },
    "command_log_path": { "type": "string", "minLength": 1 },
    "baseline_result_path": { "type": "string", "minLength": 1 },
    "scorer_results_path": { "type": "string", "minLength": 1 },
    "trace_events_path": { "type": "string", "minLength": 1 }
  }
}
