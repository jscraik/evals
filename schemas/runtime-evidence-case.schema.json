{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscraik.local/evals/runtime-evidence-case.schema.json",
  "title": "Runtime Evidence Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "suite_id",
    "intent",
    "fixture_source",
    "declared_contract",
    "resolved_runtime",
    "observed_events",
    "artifact_refs",
    "scorers",
    "expected"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "suite_id": { "type": "string", "const": "runtime-evidence" },
    "intent": { "type": "string", "minLength": 1 },
    "fixture_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provenance", "redaction_status"],
      "properties": {
        "type": { "type": "string", "const": "synthetic" },
        "provenance": { "type": "string", "minLength": 1 },
        "redaction_status": { "type": "string", "const": "synthetic_no_redaction_needed" }
      }
    },
    "declared_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_profile", "artifact_contract", "plugin_policy"],
      "properties": {
        "permission_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "filesystem", "network", "approval_fallback"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["read", "write", "deny"],
              "properties": {
                "read": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "write": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            },
            "network": { "type": "boolean" },
            "approval_fallback": { "type": "string", "enum": ["read-only", "blocked", "not_applicable"] }
          }
        },
        "artifact_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subagent_artifacts_required"],
          "properties": {
            "subagent_artifacts_required": { "type": "boolean" }
          }
        },
        "plugin_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin_id_required", "plugin_source_required"],
          "properties": {
            "plugin_id_required": { "type": "boolean" },
            "plugin_source_required": { "type": "boolean" }
          }
        },
        "goal_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durable_goal_required"],
          "properties": {
            "durable_goal_required": { "type": "boolean" }
          }
        },
        "thread_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turn_start_metadata_required"],
          "properties": {
            "turn_start_metadata_required": { "type": "boolean" }
          }
        },
        "network_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network_access", "approval_required"],
          "properties": {
            "network_access": { "type": "string", "enum": ["forbidden", "allowed", "approval_required"] },
            "approval_required": { "type": "boolean" },
            "allowed_hosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "package_provenance_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_source_required", "checksum_required", "build_artifact_required"],
          "properties": {
            "package_source_required": { "type": "boolean" },
            "checksum_required": { "type": "boolean" },
            "build_artifact_required": { "type": "boolean" }
          }
        },
        "policy_scaffolds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "goal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "type": "string", "const": "scaffolded_not_enforced" },
                "reason": { "type": "string", "minLength": 1 }
              }
            },
            "thread": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "type": "string", "const": "scaffolded_not_enforced" },
                "reason": { "type": "string", "minLength": 1 }
              }
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "type": "string", "const": "scaffolded_not_enforced" },
                "reason": { "type": "string", "minLength": 1 }
              }
            },
            "package_provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "type": "string", "const": "scaffolded_not_enforced" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "resolved_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_state", "environment_profile", "runtime_capabilities"],
      "properties": {
        "approval_state": { "type": "string", "enum": ["not_required", "requested", "pending", "approved", "denied", "disabled"] },
        "environment_profile": { "type": "string", "minLength": 1 },
        "runtime_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "goal_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source"],
          "properties": {
            "status": { "type": "string", "enum": ["not_required", "missing", "present", "stale", "unknown"] },
            "source": { "type": "string", "minLength": 1 },
            "goal_ref": { "type": ["string", "null"], "minLength": 1 },
            "objective": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "thread_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turn_start_metadata"],
          "properties": {
            "turn_start_metadata": { "type": "boolean" },
            "thread_id": { "type": ["string", "null"], "minLength": 1 },
            "compaction_policy": { "type": "string", "minLength": 1 },
            "fork_policy": { "type": "string", "minLength": 1 }
          }
        },
        "network_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network_enabled"],
          "properties": {
            "network_enabled": { "type": "boolean" },
            "allowed_hosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "package_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "package_name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "checksum": { "type": ["string", "null"], "minLength": 1 },
            "build_artifact": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      }
    },
    "observed_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "status"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "RunStarted",
              "ToolCallObserved",
              "SubagentStart",
              "ArtifactExpected",
              "ArtifactWritten",
              "ValidationRun",
              "RunFinalized"
            ]
          },
          "actor": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["agent", "runtime", "subagent", "plugin", "user"] },
          "status": { "type": "string", "minLength": 1 },
          "effect": {
            "type": "string",
            "enum": ["filesystem_read", "filesystem_write", "network_access", "tool_call", "none"]
          },
          "path_scope": {
            "type": "string",
            "enum": ["repo", "home", "credential-store", "outside-repo", "none"]
          },
          "subagent_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "artifact_type": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "plugin_id": { "type": "string", "minLength": 1 },
          "plugin_source": { "type": "string", "minLength": 1 },
          "goal_ref": { "type": "string", "minLength": 1 },
          "thread_id": { "type": "string", "minLength": 1 },
          "turn_id": { "type": "string", "minLength": 1 },
          "network_host": { "type": "string", "minLength": 1 },
          "package_name": { "type": "string", "minLength": 1 },
          "package_source": { "type": "string", "minLength": 1 },
          "package_checksum": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      },
      "minItems": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scorers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["permission-drift", "subagent-artifact-contract", "plugin-attribution"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "classification", "reason"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
        "classification": {
          "type": "string",
          "enum": ["ok", "permission_drift", "missing_subagent_artifact", "plugin_attribution_missing"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
